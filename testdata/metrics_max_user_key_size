# compacting reduces the maximum again.

batch
del-range b c
----

flush
----
L0.0:
  000016:[b#18,RANGEDEL-c#inf,RANGEDEL]
L6:
  000005:[a#10,SET-bbbbbb#11,SET]
  000014:[d#0,SET-d#0,SET]

max-key-size
----
L0:
  000016: 1
L6:
  000005: 6
  000014: 1
max user key size: 6
unknown tables: 0

compact a-z
