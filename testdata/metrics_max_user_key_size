# The metric is the size of the largest user key across all levels.

init
----

max-key-size
----
max user key size: 0
unknown tables: 0

batch
set a 1
set bbbbbb 2
----

flush
----
L0.0:
  000005:[a#10,SET-bbbbbb#11,SET]

compact a-z
----
L6:
  000005:[a#10,SET-bbbbbb#11,SET]

batch
set cccccccccc 3
set d 4
----

flush
----
L0.0:
  000007:[cccccccccc#12,SET-d#13,SET]
L6:
  000005:[a#10,SET-bbbbbb#11,SET]

max-key-size
----
L0:
  000007: 10
L6:
  000005: 6
max user key size: 10
unknown tables: 0

# The largest key can be the end key of a range deletion...

batch
del-range e eeeeeeeeeeeeeeeeeeee
----

flush
----
L0.0:
  000007:[cccccccccc#12,SET-d#13,SET]
  000009:[e#14,RANGEDEL-eeeeeeeeeeeeeeeeeeee#inf,RANGEDEL]
L6:
  000005:[a#10,SET-bbbbbb#11,SET]

max-key-size
----
L0:
  000007: 10
  000009: 20
L6:
  000005: 6
max user key size: 20
unknown tables: 0

# ... or a range key bound.

batch
range-key-set ffffffffffffffffffffffffffffff g @5 foo
----

flush
----
L0.0:
  000007:[cccccccccc#12,SET-d#13,SET]
  000009:[e#14,RANGEDEL-eeeeeeeeeeeeeeeeeeee#inf,RANGEDEL]
  000011:[ffffffffffffffffffffffffffffff#15,RANGEKEYSET-g#inf,RANGEKEYSET]
L6:
  000005:[a#10,SET-bbbbbb#11,SET]

max-key-size
----
L0:
  000007: 10
  000009: 20
  000011: 30
L6:
  000005: 6
max user key size: 30
unknown tables: 0

# Deleting the range key and the 10-byte key, then compacting everything into
# L6, drops them along with the range deletion (which is elided at the
# bottommost level); the annotator recomputes the maximum.

batch
range-key-del ffffffffffffffffffffffffffffff g
del cccccccccc
----

flush
----
L0.1:
  000013:[cccccccccc#17,DEL-g#inf,RANGEKEYDEL]
L0.0:
  000007:[cccccccccc#12,SET-d#13,SET]
  000009:[e#14,RANGEDEL-eeeeeeeeeeeeeeeeeeee#inf,RANGEDEL]
  000011:[ffffffffffffffffffffffffffffff#15,RANGEKEYSET-g#inf,RANGEKEYSET]
L6:
  000005:[a#10,SET-bbbbbb#11,SET]

compact a-z
----
L6:
  000005:[a#10,SET-bbbbbb#11,SET]
  000014:[d#0,SET-d#0,SET]

max-key-size
----
L6:
  000005: 6
  000014: 1
max user key size: 6
unknown tables: 0

