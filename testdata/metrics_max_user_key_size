batch
set a 1
set bbbbbbbbbbbbbbbbbbbb 2
set c 3
----

flush
----
L0.0:
  000005:[a#10,SET-c#12,SET]

compact a-z
----
L6:
  000005:[a#10,SET-c#12,SET]

max-key-size
----
L6:
  000005: 20
max user key size: 20
unknown tables: 0

excise b bz
----
L6:
  000006(000005):[a#10,SET-a#10,SET]
  000007(000005):[c#12,SET-c#12,SET]

max-key-size
