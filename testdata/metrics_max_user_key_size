# External tables with a synthetic prefix and/or suffix report the backing's
# value plus the synthetic prefix and suffix lengths. This is an upper bound:
# the synthetic suffix replaces the existing suffix.

init
----

build-remote ext
aaaa@10#0,SET:a
b@11#0,SET:b
----

ingest-external
ext bounds=(a,c) synthetic-suffix=@123
ext bounds=(xyza,xyzc) synthetic-prefix=xyz
----
L6:
  000004(000004):[a#10,DELSIZED-c#inf,RANGEDEL]
  000005(000004):[xyza#11,DELSIZED-xyzc#inf,RANGEDEL]

max-key-size
----
L6:
  000004(000004): 7 synthetic-suffix="@123"
  000005(000004): 7 synthetic-prefix="xyz"
max user key size: 11
unknown tables: 0

build-remote ext2
c@1#0,SET:c
