# The base is in a lower level and no snapshot is open. The operands sum to zero
# without the base, and the compaction that reaches the base merges them into
# it, so the base's value stays visible.
define merger=deletable
set a 5
set b 1
compact a-z
merge a 2
merge a -2
compact a-z
