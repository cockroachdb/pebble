# A snapshot separates merge operands from their base. The newer operands sum
# to zero without the base and are written as a MERGE, so both readers see the
# older stripe's result.
define merger=deletable
set a 5
merge a -1
set b 1
snapshot 1
merge a 2
merge a -2
compact a-z
